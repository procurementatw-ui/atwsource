{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,"buildCommand":"npm run build","outputDirectory":"public",
 "functions":{"api/index.mjs":{"maxDuration":30}},
 "rewrites":[{"source":"/api/:path*","destination":"/api/index"}],
 "headers":[
  {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]},
  {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
  {"source":"/application.html","headers":[{"key":"Cache-Control","value":"no-cache, must-revalidate"}]},
  {"source":"/launcher.js","headers":[{"key":"Cache-Control","value":"no-cache, must-revalidate"}]}
 ]
}
