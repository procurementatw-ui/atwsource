      "bytes": 48528,
      "sha256": "ef816cdab8f44c1e4f938678c2647ebec5765181e088fbcb5d5b5d37ba65fcc5"
    },
    {
      "key": "itemcode",
      "language": "en",
      "text": "Start with the item catalogue. If the right code isn't there, I can guide a new request.",
      "file": "en-itemcode.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 38880,
      "sha256": "4135606c4a13e11ce8bf66a1be6a51546ae3f9a00d9af1827247ebf23f7b2279"
    },
    {
      "key": "prices",
      "language": "en",
      "text": "Let's check the recorded prices first. That gives us a useful starting point.",
      "file": "en-prices.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 36432,
      "sha256": "afc4e82b1cdd8e7ce25557cb82a0367a65a1f878c1b6b64dbca7bcf841dac91b"
    },
    {
      "key": "budget",
      "language": "en",
      "text": "Let's build your budget together. Choose the purpose, review the work items, then confirm the quantities and prices.",
      "file": "en-budget.mp3",
