      "bytes": 30816,
      "sha256": "10675fac26a4811d7e7d05c5a7ffe0bfe1056c3185accaf32d65d60c532c98b3"
    },
    {
      "key": "ticket",
      "language": "en",
      "text": "Let's prepare your request. Choose its category, complete the required fields, then review it before submitting.",
      "file": "en-ticket.mp3",
