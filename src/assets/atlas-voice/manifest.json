      "bytes": 38160,
      "sha256": "738ff015fc66563c70373a9170063c42576f143fb0cff9743e9604bcee58ed22"
    },
    {
      "key": "employee",
      "language": "en",
      "text": "Welcome! I can guide your requests, item codes, prices and budgets. Which one do you need?",
      "file": "en-employee.mp3",
