      "bytes": 48384,
      "sha256": "fab1f6b1615d541382f7bed8922c7e2a41ec33b650fab5eab635a4cf2c0fefcf"
    },
    {
      "key": "invoice",
      "language": "en",
      "text": "Let's check the invoice and its supporting documents against the linked order.",
      "file": "en-invoice.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 29232,
      "sha256": "b2ee6d124a453faa06d2577f1087a12948d1bac063beca97ee4785cf975c04ab"
    },
    {
      "key": "tracking",
      "language": "en",
      "text": "Use a recorded request or order number. We'll follow the journey and see what's next.",
      "file": "en-tracking.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 37728,
      "sha256": "ba736fc7d4187d9be7b9a3e480b7bec9e26dca40d6b565762a2972e28fb06e7c"
    },
    {
      "key": "approval",
      "language": "en",
      "text": "I'll help you review the next step. The authorized approver makes the final decision in ATW Source.",
      "file": "en-approval.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 45072,
      "sha256": "d672feb82022d0a87603f105a0eecbe8b80999b4b755b426899dc703293923ba"
    },
    {
      "key": "wbs",
      "language": "en",
      "text": "For a confidential report, use the reporting form and keep the reference and access code safely.",
      "file": "en-wbs.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 37728,
      "sha256": "d2c7789459317020c5a3d41e7be2374edcd0433d387818447d71c1f210bb85ee"
    },
    {
      "key": "summaryPending",
      "language": "en",
      "text": "The summary is ready. There are follow-ups to review. Shall we start with the first one?",
      "file": "en-summaryPending.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 41184,
      "sha256": "b0dbb513e01b242daa8973a8da3b54b56c7f65376d4cbee4cfb1fbcb74a96773"
    },
    {
      "key": "summaryClear",
      "language": "en",
      "text": "No outstanding follow-ups on this page. What would you like to work on next?",
