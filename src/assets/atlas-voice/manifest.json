      "sha256": "0d3b153a284a72da87b35efa831ede0933f901420f76b628d4a59cd63f7d18cc"
    },
    {
      "key": "budgetMissing",
      "language": "en",
      "text": "The budget structure is ready. Some prices still need confirmation. Let's check them together.",
