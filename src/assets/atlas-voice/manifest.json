      "sha256": "983775301dc4a0cb549ec5f3e5d1afd2824e782d59193435c86af29cbf746639"
    },
    {
      "key": "choose",
      "language": "en",
      "text": "Let's find the right starting point. Are you from ATW Group, or are you a vendor?",
