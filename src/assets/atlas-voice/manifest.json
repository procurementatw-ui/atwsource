      "sha256": "c50e4b7bda19bf15acb7a5cfe62150697e9abf64596b7c1948c73b05d533e48b"
    },
    {
      "key": "budgetReady",
      "language": "en",
      "text": "The budget review is ready. Let's look at lead times, procurement priorities and possible bottlenecks.",
