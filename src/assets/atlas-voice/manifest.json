      "bytes": 48816,
      "sha256": "f21d78a33d0068693bbb68cc1a05575f111b5e52721a30cca65428c6b45230a3"
    },
    {
      "key": "vendor",
      "language": "en",
      "text": "Welcome! I can help with registration, quotations, documents and order progress. Where shall we start?",
      "file": "en-vendor.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 52704,
      "sha256": "5d438bbd451ea445e90f6090acdf34d419ca185b70a0bbbb44cf89c0febe41c7"
    },
    {
      "key": "registration",
      "language": "en",
      "text": "Let's get your registration ready. Choose your company profile, then follow the matching document list.",
      "file": "en-registration.mp3",
      "voice": "en-US-AriaNeural",
      "bytes": 43344,
      "sha256": "0395114e77826ca301d74b7520d09fbd0b721116adefbc14839a2da5eca93cf2"
    },
    {
      "key": "login",
      "language": "en",
      "text": "Use your registered email to continue. I'll guide you from there.",
