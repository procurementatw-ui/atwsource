      "bytes": 28368,
      "sha256": "c18d5508fdf2796c1c6530a9896d58974589dd5a5b207db185f4a98aca13a2ca"
    },
    {
      "key": "quote",
      "language": "en",
      "text": "Open an RFQ invitation for your company. Check the scope, prices and documents before sending your quotation.",
      "file": "en-quote.mp3",
